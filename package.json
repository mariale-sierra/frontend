    "jest": "^29.7.0",
    "jest-expo": "^54.0.0",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "services/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "i18n/**/*.{ts,tsx}"
